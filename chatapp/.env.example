# ============================================================================
# ChatApp Environment Configuration
# ============================================================================
# Copy to `.env` and fill in values. Most production values are populated
# automatically by `./sync-env.sh --region <region>` after CDK deploys.
# For local dev without AWS, set DEV_MODE=true to bypass Cognito.
# ============================================================================

# ── Deployment / Auth ───────────────────────────────────────────────────────
AWS_REGION=us-east-1
APP_URL=http://localhost:8080

# AWS Cognito (required unless DEV_MODE=true)
COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
COGNITO_CLIENT_ID=your-cognito-client-id
COGNITO_CLIENT_SECRET=your-cognito-client-secret

# Development bypass — skip Cognito entirely, impersonate DEV_USER_ID
# Set DEV_MODE=true for local work; leave unset (or false) in production.
DEV_MODE=false
DEV_USER_ID=dev-user-001
# Enable template/static file hot-reload during local development
DEV_RELOAD=false

# ── AgentCore Runtimes ──────────────────────────────────────────────────────
# Explorer is the primary chat agent. Required.
EXPLORER_RUNTIME_ARN=arn:aws:bedrock-agentcore:us-east-1:123456789012:runtime/explorer-xxxxx

# Discovery agent is admin-only. Optional — leave blank if not deployed.
DISCOVERY_RUNTIME_ARN=arn:aws:bedrock-agentcore:us-east-1:123456789012:runtime/discovery-xxxxx

# AgentCore Memory ID for session persistence. Required.
MEMORY_ID=your-memory-id

# Default Bedrock model id. See chatapp/app/admin/cost_calculator.py::MODELS
# for the full list. Injected by CDK into both runtimes and the chatapp.
DEFAULT_MODEL_ID=global.anthropic.claude-sonnet-4-6

# ── DynamoDB Tables ─────────────────────────────────────────────────────────
# Defaults come from the CDK config (appName=mfg-ukg). Override if you
# deployed with a different appName or renamed tables manually.
USAGE_TABLE_NAME=mfg-ukg-usage-records
FEEDBACK_TABLE_NAME=mfg-ukg-feedback
GUARDRAIL_TABLE_NAME=mfg-ukg-guardrail-violations
PROMPT_TEMPLATES_TABLE_NAME=mfg-ukg-prompt-templates
APP_SETTINGS_TABLE_NAME=mfg-ukg-app-settings
RUNTIME_USAGE_TABLE_NAME=mfg-ukg-runtime-usage
REGISTRY_TABLE_NAME=mfg-ukg-system-registry
DISCOVERY_HISTORY_TABLE_NAME=mfg-ukg-discovery-history
WORKFLOWS_TABLE_NAME=mfg-ukg-saved-workflows
WORKFLOW_RESULTS_TABLE_NAME=mfg-ukg-workflow-results

# ── Registry Gateway ───────────────────────────────────────────────────
# AgentCore Gateway id for the shared registry tool surface.
REGISTRY_GATEWAY_ID=your-gateway-id

# ── Workflow Executor ───────────────────────────────────────────────────────
# ARN of the Lambda that runs saved workflows on-demand and on schedule.
WORKFLOW_EXECUTOR_ARN=arn:aws:lambda:us-east-1:123456789012:function:mfg-ukg-workflow-executor
# EventBridge Scheduler group + role used when scheduling workflows.
WORKFLOW_SCHEDULER_GROUP=mfg-ukg-workflow-schedules
WORKFLOW_SCHEDULER_ROLE_ARN=arn:aws:iam::123456789012:role/mfg-ukg-scheduler-role

# ── Bedrock Guardrails ───────────────────────────────────────────────────
# GUARDRAIL_ID and GUARDRAIL_VERSION come from the Bedrock stack.
# Set GUARDRAIL_ENABLED=false to bypass filtering without unsetting the id.
GUARDRAIL_ID=your-guardrail-id
GUARDRAIL_VERSION=1
GUARDRAIL_ENABLED=true

# ── Bedrock Knowledge Base + ingestion ──────────────────────────────────────
# Used by the chatapp's KB writer (validated-answer + gotcha writes).
# Both must be set for writes to reach the KB; otherwise writes are skipped.
KB_ID=your-kb-id
KB_SYNC_STATE_TABLE_NAME=mfg-ukg-kb-sync-state

# ── Bedrock AgentCore Evaluations (optional) ─────────────────────────────────
# Evaluation config IDs surfaced in the admin dashboard. Leave blank to
# hide the evaluation panels.
EXPLORER_EVAL_CONFIG_ID=
DISCOVERY_EVAL_CONFIG_ID=
